# Application
NODE_ENV=development
PORT=5000

# Database
# For cloud/local MongoDB, e.g. mongodb://localhost:27017/business_inventory or mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/business_inventory

# Frontend Client URL
FRONTEND_URL=http://localhost:3000

# Authentication & Security
# Generate secure random strings for production: openssl rand -base64 32
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies & CORS
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Logging & Monitoring
LOG_LEVEL=debug

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Optional File Storage Provider (local | s3 | r2)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_URL=
FILE_STORAGE_KEY=
FILE_STORAGE_SECRET=
FILE_STORAGE_BUCKET=
